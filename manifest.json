{
  "manifest_version": 3,
  "name": "Forbidden URLS",
  "version": "1.1",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/youtube.js"]
    }
  ],
  "background":{
    "service_worker":"background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions":[
    "storage",
    "tabs"
  ]
}

